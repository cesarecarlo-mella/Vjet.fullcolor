                    SuperscriptBox["eps", "3"]}]]}], "+", 
                 FractionBox[
                  RowBox[{"11", " ", "Beta0", " ", "Beta1"}], 
                  RowBox[{"24", " ", 
                   SuperscriptBox["eps", "2"]}]], "-", 
                 FractionBox["Beta2", 
                  RowBox[{"6", " ", "eps"}]]}], ")"}], " ", 
               RowBox[{
                RowBox[{"FFun", "[", "0", "]"}], "[", "x", "]"}]}]}], ")"}]}],
            "  ", "/.", " ", "deltarule"}], ",", 
          RowBox[{"{", 
