     RowBox[{"2", "*", 
      RowBox[{"gq", "[", "i", "]"}]}], " ", "+", " ", 
     RowBox[{"gg", "[", "i", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Z1", "[", "eps_", "]"}], " ", ":=", " ", 
