Cell[BoxData[
 RowBox[{
  RowBox[{"PolePredictionPS", "[", "x_", "]"}], ":=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"SCET3", "[", "eps", "]"}], "*", 
                RowBox[{
                 RowBox[{"PP", "[", "0", "]"}], "[", "x", "]"}]}], "+", 
               RowBox[{
                RowBox[{"SCET2", "[", "eps", "]"}], "*", 
                RowBox[{
                 RowBox[{"PP", "[", "1", "]"}], "[", "x", "]"}]}], "+"}], 
              "*)"}], 
             RowBox[{
              RowBox[{"SCET1", "[", "eps", "]"}], "*", 
              RowBox[{
               RowBox[{"PP", "[", "2", "]"}], "[", "x", "]"}]}], ")"}], "-", 
            RowBox[{"(", " ", 
             RowBox[{
              RowBox[{"-", 
               FractionBox[
                RowBox[{"5", " ", "Beta0", " "}], 
                RowBox[{"2", " ", "eps"}]]}], 
              RowBox[{
               RowBox[{"PSun", "[", "2", "]"}], "[", "x", "]"}]}], " ", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"+", 
                 RowBox[{"(", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"15", " ", 
                    SuperscriptBox["Beta0", "2"]}], 
                    RowBox[{"8", " ", 
                    SuperscriptBox["eps", "2"]}]], "-", 
                   FractionBox[
                    RowBox[{"3", " ", "Beta1"}], 
                    RowBox[{"4", " ", "eps"}]]}], ")"}]}], " ", 
                RowBox[{
                 RowBox[{"PSun", "[", "1", "]"}], "[", "x", "]"}]}], "+", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", 
                   FractionBox[
                    RowBox[{"5", " ", 
                    SuperscriptBox["Beta0", "3"]}], 
                    RowBox[{"16", " ", 
                    SuperscriptBox["eps", "3"]}]]}], "+", 
                  FractionBox[
                   RowBox[{"11", " ", "Beta0", " ", "Beta1"}], 
                   RowBox[{"24", " ", 
                    SuperscriptBox["eps", "2"]}]], "-", 
                  FractionBox["Beta2", 
                   RowBox[{"6", " ", "eps"}]]}], ")"}], " ", 
                RowBox[{
                 RowBox[{"PSun", "[", "0", "]"}], "[", "x", "]"}]}]}], "*)"}],
              ")"}]}], "  ", "/.", " ", "deltarule"}], ",", 
          RowBox[{"{", 
           RowBox[{"eps", ",", "0", ",", "0"}], "}"}]}], "]"}], "//", 
        "Normal"}], ")"}], "/.", " ", "logs"}], "//", "ShuffleG"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "eps", ",", "Nf", ",", "Nc", ",", "Pi", ",", "_Zeta", ",", "_G"}], "}"}],
     ",", "Together"}], "]"}]}]], "Input",
