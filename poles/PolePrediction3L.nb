Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"FF", "[", "0", "]"}], "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"FFun", "[", "0", "]"}], "[", "x", "]"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"FF", "[", "1", "]"}], "[", "x_", "]"}]}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FFun", "[", "1", "]"}], "[", "x", "]"}], " ", "-", 
      RowBox[{
       FractionBox[
        RowBox[{"Beta0", " "}], 
        RowBox[{"2", " ", "eps"}]], 
       RowBox[{
        RowBox[{"FFun", "[", "0", "]"}], "[", "x", "]"}], "\n", 
       RowBox[{
        RowBox[{"FF", "[", "2", "]"}], "[", "x_", "]"}]}]}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"FFun", "[", "2", "]"}], "[", "x", "]"}], " ", "-", 
       RowBox[{
        FractionBox[
         RowBox[{"3", " ", "Beta0", " "}], 
         RowBox[{"2", " ", "eps"}]], " ", 
        RowBox[{
         RowBox[{"FFun", "[", "1", "]"}], "[", "x", "]"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox["Beta0", "2"]}], 
           RowBox[{"8", " ", 
            SuperscriptBox["eps", "2"]}]], "-", 
          FractionBox["Beta1", 
           RowBox[{"4", " ", "eps"}]]}], ")"}], " ", 
        RowBox[{
         RowBox[{"FFun", "[", "0", "]"}], "[", "x", "]"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FF", "[", "3", "]"}], "[", "x_", "]"}]}]}], " ", ":=", " ", 
      
      RowBox[{
       RowBox[{"FF3un", "[", "x", "]"}], " ", "-", 
       RowBox[{
        FractionBox[
         RowBox[{"5", " ", "Beta0", " "}], 
         RowBox[{"2", " ", "eps"}]], 
        RowBox[{
         RowBox[{"FFun", "[", "2", "]"}], "[", "x", "]"}]}], " ", "+", 
       RowBox[{
        RowBox[{"(", 
