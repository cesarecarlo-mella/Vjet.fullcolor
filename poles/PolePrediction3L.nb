         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", " ", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"SCET1", "[", "eps", "]"}], "*", 
               RowBox[{
                RowBox[{"FF", "[", "0", "]"}], "[", "x", "]"}]}], ")"}], ",", 
             "\[IndentingNewLine]", " ", 
             RowBox[{"{", 
              RowBox[{"eps", ",", " ", "0", ",", " ", 
               RowBox[{"-", "1"}]}], "}"}]}], "]"}], " ", "/.", " ", "logs"}],
           "//", "Normal"}], "//", "ShuffleG"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"z", ",", "y"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"{", 
       RowBox[{"eps", ",", "_FFun", ",", "Nf", ",", "Nc", ",", "_G"}], "}"}], 
      ",", "Together"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PolesFF2", "[", "x_", "]"}], " ", ":=", " ", "\n", 
