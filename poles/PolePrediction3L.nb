Cell[BoxData[
 RowBox[{
  RowBox[{"PolePrediction", "[", "x_", "]"}], ":=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"SCET3", "[", "eps", "]"}], "*", 
               RowBox[{
                RowBox[{"FF", "[", "0", "]"}], "[", "x", "]"}]}], "+", 
              RowBox[{
               RowBox[{"SCET2", "[", "eps", "]"}], "*", 
               RowBox[{
                RowBox[{"FF", "[", "1", "]"}], "[", "x", "]"}]}], "+", 
              RowBox[{
               RowBox[{"SCET1", "[", "eps", "]"}], "*", 
               RowBox[{
                RowBox[{"FF", "[", "2", "]"}], "[", "x", "]"}]}]}], ")"}], "-", 
            RowBox[{"(", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                FractionBox[
                 RowBox[{"5", " ", "Beta0", " "}], 
                 RowBox[{"2", " ", "eps"}]]}], 
               RowBox[{
                RowBox[{"FFun", "[", "2", "]"}], "[", "x", "]"}]}], " ", "+", 
              
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 FractionBox[
                  RowBox[{"15", " ", 
                   SuperscriptBox["Beta0", "2"]}], 
                  RowBox[{"8", " ", 
                   SuperscriptBox["eps", "2"]}]], "-", 
                 FractionBox[
                  RowBox[{"3", " ", "Beta1"}], 
                  RowBox[{"4", " ", "eps"}]]}], ")"}], " ", 
               RowBox[{
                RowBox[{"FFun", "[", "1", "]"}], "[", "x", "]"}]}], "+", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   RowBox[{"5", " ", 
                    SuperscriptBox["Beta0", "3"]}], 
