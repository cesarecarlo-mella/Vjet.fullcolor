           RowBox[{"8", " ", 
            SuperscriptBox["eps", "2"]}]], "-", 
          FractionBox[
           RowBox[{"3", " ", "Beta1"}], 
           RowBox[{"4", " ", "eps"}]]}], ")"}], " ", 
        RowBox[{
         RowBox[{"FFun", "[", "1", "]"}], "[", "x", "]"}]}], "+", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"5", " ", 
             SuperscriptBox["Beta0", "3"]}], 
