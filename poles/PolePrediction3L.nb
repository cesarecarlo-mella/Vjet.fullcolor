Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"alf", ":=", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"Beta0", "/", "eps"}], " ", "a"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Beta0", "^", "2"}], "/", 
         RowBox[{"eps", "^", "2"}]}], "-", 
        RowBox[{
         RowBox[{"Beta1", "/", "2"}], "/", "eps"}]}], ")"}], 
      RowBox[{"a", "^", "2"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Beta0", "^", "3"}], "/", 
         RowBox[{"eps", "^", "3"}]}], "-", 
        RowBox[{"7", " ", "Beta0", " ", 
         RowBox[{
          RowBox[{"Beta1", "/", "6"}], "/", 
          RowBox[{"eps", "^", "2"}]}]}], "+", 
        RowBox[{
         RowBox[{"Beta2", "/", "3"}], "/", "eps"}]}], ")"}], " ", 
      RowBox[{"a", "^", "3"}]}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", "alf", "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"M", "[", "0", "]"}], "+", 
         RowBox[{
          RowBox[{"M", "[", "1", "]"}], " ", "a", " ", "alf"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"M", "[", "2", "]"}], "  ", 
          RowBox[{"a", "^", "2"}], " ", 
          RowBox[{"alf", "^", "2"}]}], "+", " ", 
         RowBox[{
          RowBox[{"M", "[", "3", "]"}], "  ", 
          RowBox[{"a", "^", "3"}], " ", 
          RowBox[{"alf", "^", "3"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "0", ",", "3"}], "}"}]}], "]"}], "//", "Normal"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "_M", ",", "eps"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"bc083076-1217-4cf3-abca-fc3e8c81abc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", "[", "0", "]"}], "+", 
  RowBox[{"a", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Beta0", " ", 
        RowBox[{"M", "[", "0", "]"}]}], 
       RowBox[{"2", " ", "eps"}]]}], "+", 
     RowBox[{"M", "[", "1", "]"}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"3", " ", 
          SuperscriptBox["Beta0", "2"]}], 
         RowBox[{"8", " ", 
          SuperscriptBox["eps", "2"]}]], "-", 
        FractionBox["Beta1", 
         RowBox[{"4", " ", "eps"}]]}], ")"}], " ", 
      RowBox[{"M", "[", "0", "]"}]}], "-", 
     FractionBox[
      RowBox[{"3", " ", "Beta0", " ", 
       RowBox[{"M", "[", "1", "]"}]}], 
      RowBox[{"2", " ", "eps"}]], "+", 
     RowBox[{"M", "[", "2", "]"}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["a", "3"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"5", " ", 
           SuperscriptBox["Beta0", "3"]}], 
          RowBox[{"16", " ", 
           SuperscriptBox["eps", "3"]}]]}], "+", 
        FractionBox[
         RowBox[{"11", " ", "Beta0", " ", "Beta1"}], 
         RowBox[{"24", " ", 
          SuperscriptBox["eps", "2"]}]], "-", 
        FractionBox["Beta2", 
         RowBox[{"6", " ", "eps"}]]}], ")"}], " ", 
      RowBox[{"M", "[", "0", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"15", " ", 
          SuperscriptBox["Beta0", "2"]}], 
         RowBox[{"8", " ", 
          SuperscriptBox["eps", "2"]}]], "-", 
        FractionBox[
         RowBox[{"3", " ", "Beta1"}], 
         RowBox[{"4", " ", "eps"}]]}], ")"}], " ", 
      RowBox[{"M", "[", "1", "]"}]}], "-", 
     FractionBox[
      RowBox[{"5", " ", "Beta0", " ", 
       RowBox[{"M", "[", "2", "]"}]}], 
      RowBox[{"2", " ", "eps"}]], "+", 
     RowBox[{"M", "[", "3", "]"}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.896173380327388*^9, 3.8961935712456923`*^9, 
